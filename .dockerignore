# The build stage runs `npm ci` from the lockfile and `next build` from
# source; everything below is either rebuilt, irrelevant to the image, or
# something that must never be baked into a layer.
node_modules
.next
.git
.github
.data
.shots
*.log

# Secrets live in the platform's secret store, never in an image layer.
.env
.env.*
!.env.example

# Not part of the server.
README.md
project-map.md
docs
scripts/screenshots.mts
scripts/make-image-fixtures.py
