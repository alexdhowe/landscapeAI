{
  "name": "landscape-ai",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.11.0 <23"
  },
  "packageManager": "npm@10.9.7",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test": "vitest run",
    "test:watch": "vitest",
    "doctor": "tsx scripts/doctor.ts",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:migrate:direct": "tsx scripts/db-migrate.ts",
    "db:seed": "tsx scripts/db-seed.ts",
    "db:setup": "npm run db:migrate && npm run db:seed",
    "db:user": "tsx scripts/db-user.ts",
    "segment": "tsx scripts/segment.mts",
    "shots": "tsx scripts/screenshots.mts",
    "smoke": "tsx scripts/smoke.mts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.120.0",
    "@turf/area": "^7.4.0",
    "@turf/helpers": "^7.4.0",
    "@turf/length": "^7.4.0",
    "drizzle-orm": "^0.44.0",
    "heic-decode": "^2.1.0",
    "jpeg-js": "^0.4.4",
    "maplibre-gl": "^6.4.1",
    "next": "^15.4.0",
    "next-auth": "^5.0.0-beta.32",
    "postgres": "^3.4.5",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "terra-draw": "^1.32.3",
    "terra-draw-maplibre-gl-adapter": "^1.4.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.3.16",
    "@tailwindcss/postcss": "^4.1.0",
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "drizzle-kit": "^0.31.0",
    "playwright": "^1.56.0",
    "tailwindcss": "^4.1.0",
    "tsx": "^4.23.12",
    "typescript": "^5.8.0",
    "vitest": "^3.2.0"
  }
}
